    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, Helvetica, Arial, sans-serif;
        }

        html, body {
            background-image: url('https://plus.unsplash.com/premium_photo-1671410372744-989627ea0033?fm=jpg&q=60&w=3000&auto=format&fit=crop&ixlib=rb-4.1.0&ixid=M3wxMjA3fDB8MHxzZWFyY2h8MTF8fG1hcmJsZSUyMHdhbGxwYXBlcnxlbnwwfHwwfHx8MA%3D%3D');
            background-size: cover;
            background-position: center;
            background-attachment: fixed;
            background-color: #e0e5e9; 
            color: #1a1a1a;
            overflow-x: hidden;
            width: 100%;
            min-height: 100vh;
            display: flex;
            justify-content: center;
            padding: 3rem 2rem; 
        }

        .page-wrapper {
            background-color: #f8f7f4; 
            width: 100%;
            max-width: 1200px;
            border-radius: 24px; 
            box-shadow: 0 25px 50px -12px rgba(0, 0, 0, 0.25); 
            overflow: hidden; 
            position: relative;
            display: flex;
            flex-direction: column;
            align-items: center;
        }

        .top-section {
            width: 100%;
            padding: 3rem 2rem 0 2rem; 
            margin: 0 auto;
            position: relative;
            z-index: 20; 
        }

        .header {
            display: flex;
            align-items: center;
            margin-bottom: 5rem;
            width: 100%;
        }

        .header-left {
            display: flex;
            align-items: center;
            gap: 1.5rem;
            flex: 1;
        }

        .header-center {
            display: flex;
            justify-content: center;
        }

        .social-icons {
            display: flex;
            gap: 1.2rem;
            font-size: 1.2rem;
            flex: 1;
            justify-content: flex-end;
        }

        .lang-switcher {
            position: relative;
            display: inline-block;
        }

        .lang-btn {
            background: #fff;
            border: 1px solid #d1d1d1;
            border-radius: 50px;
            padding: 0.5rem 1rem;
            cursor: pointer;
            font-size: 1rem;
            display: flex;
            align-items: center;
            gap: 0.5rem;
            color: #1a1a1a;
            box-shadow: 0 2px 5px rgba(0,0,0,0.05);
            transition: all 0.2s;
        }

        .lang-btn:hover { background: #f0f0f0; }

        .lang-dropdown {
            display: none; 
            position: absolute;
            top: 110%;
            left: 0;
            background: #fff;
            border: 1px solid #d1d1d1;
            border-radius: 12px;
            box-shadow: 0 10px 25px rgba(0,0,0,0.1);
            min-width: 140px;
            z-index: 100;
            overflow: hidden;
        }

        .lang-switcher:hover .lang-dropdown { display: block; }

        .lang-dropdown a {
            display: flex;
            align-items: center;
            gap: 0.5rem;
            padding: 0.8rem 1.2rem;
            text-decoration: none;
            color: #1a1a1a;
            font-size: 0.95rem;
            font-weight: 500;
            transition: background 0.2s;
        }

        .lang-dropdown a:hover { background: #f5f5f5; }

        .logo {
            font-family: serif;
            font-size: 2.2rem;
            font-weight: bold;
            letter-spacing: -1px;
            text-decoration: none;
            color: #1a1a1a;
        }

        .nav-pill {
            display: flex;
            gap: 1.5rem;
            border: 1px solid #d1d1d1;
            border-radius: 50px;
            padding: 0.8rem 2.5rem;
            background: #f8f7f4;
        }

        .nav-pill a {
            text-decoration: none;
            color: #444;
            font-size: 0.95rem;
        }

        .nav-pill a.active, .nav-pill a:hover {
            color: #000;
            font-weight: 500;
        }

        .social-icons a {
            color: #1a1a1a;
            text-decoration: none;
        }

        .services-wrapper {
            padding: 0 4rem 6rem 4rem;
            width: 100%;
            max-width: 1100px;
        }

        .services-header {
            text-align: center;
            margin-bottom: 4rem;
        }

        .services-header h1 {
            font-size: 4rem;
            font-weight: 800;
            letter-spacing: -2px;
            margin-bottom: 1rem;
            line-height: 1;
        }

        .services-header p {
            font-size: 1.2rem;
            color: #666;
        }

        .services-grid {
            display: grid;
            grid-template-columns: repeat(2, 1fr);
            gap: 2.5rem;
        }

        .service-card {
            background: #ffffff;
            border: 1px solid #eaeaea;
            border-radius: 20px;
            padding: 3rem;
            display: flex;
            flex-direction: column;
            align-items: flex-start;
            transition: transform 0.3s ease, box-shadow 0.3s ease;
        }

        .service-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(0,0,0,0.06);
        }

        .service-icon {
            font-size: 2.5rem;
            color: #1a1a1a;
            margin-bottom: 1.5rem;
        }

        .service-card h3 {
            font-size: 1.8rem;
            margin-bottom: 1rem;
            letter-spacing: -0.5px;
            font-weight: 700;
        }

        .service-card p {
            color: #555;
            line-height: 1.6;
            margin-bottom: 2.5rem;
            font-size: 1.05rem;
            flex-grow: 1; /* Pushes the price badge to the bottom */
        }

        .service-card .price {
            display: inline-block;
            padding: 0.6rem 1.5rem;
            background: #f4f3ef;
            border: 1px solid #e0dfdb;
            border-radius: 50px;
            font-weight: 600;
            font-size: 0.95rem;
            color: #1a1a1a;
        }

        .footer-cta {
            text-align: center;
            padding: 3rem 2rem 5rem 2rem;
            width: 100%;
            background-color: #f8f7f4;
            border-top: 1px solid #eaeaea;
            margin-top: auto;
        }

        .footer-cta p {
            font-size: 1.1rem;
            color: #1a1a1a;
            line-height: 1.5;
        }

        @media (max-width: 768px) {
            html, body { padding: 1rem 0.5rem; }
            .page-wrapper { border-radius: 16px; box-shadow: 0 10px 25px rgba(0, 0, 0, 0.2); }
            .header { flex-direction: column; align-items: stretch; margin-bottom: 2rem; }
            .header-left { width: 100%; justify-content: space-between; margin-bottom: 1rem; }
            .nav-pill { display: none; }
            .social-icons { justify-content: center; margin-top: 1rem; }
            
            .services-wrapper { padding: 0 1.5rem 4rem 1.5rem; }
            .services-header h1 { font-size: 3rem; }
